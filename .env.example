# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
# Une seule des deux suffit (elles sont interchangeables dans le code)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_SERVICE_KEY=your_service_role_key
# Anon key (utilisée pour la validation des JWT côté auth)
SUPABASE_ANON_KEY=your_anon_key

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=https://vykso.com

# ============================================
# YouTube OAuth Configuration
# ============================================
# JSON content of your Google Cloud OAuth 2.0 credentials
# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_SECRETS_JSON={"web":{"client_id":"...","client_secret":"...","redirect_uris":["..."]}}
# Secret HMAC pour signer le state OAuth (anti-CSRF). Fallback : clé service Supabase.
OAUTH_STATE_SECRET=change_me_random_64_chars

# ============================================
# Stripe Configuration
# ============================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Active automatic_tax + tax_id_collection (nécessite Stripe Tax configuré dans le dashboard)
STRIPE_AUTOMATIC_TAX=false

# --------------------------------------------
# PROFESSIONAL Tier Price IDs (pubs/commerciales, 16:9, durée variable)
# plan stocké : professional_starter / professional_pro / professional_max
# --------------------------------------------
# Professionnel Starter — 199,00 €/mois (annuel 179 €/mois) — 600 crédits/mois
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
# Professionnel Pro — 589,00 €/mois (annuel 530 €/mois) — 1200 crédits/mois
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
# Professionnel Max — 1 199,00 €/mois (annuel 1 079 €/mois) — 1800 crédits/mois
STRIPE_PRICE_MAX=price_...
STRIPE_PRICE_MAX_ANNUAL=price_...

# --------------------------------------------
# CREATOR Tier Price IDs (TikTok/Shorts, 9:16, durée fixe)
# plan stocké : creator_basic / creator_pro / creator_max
# --------------------------------------------
# Creator Basic — 34,99 €/mois — 100 crédits/mois
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_YEARLY=price_...
# Creator Pro — 65,99 €/mois — 200 crédits/mois
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
# Creator Max — 89,99 €/mois — 300 crédits/mois
STRIPE_PRICE_MAX_MONTHLY=price_...
STRIPE_PRICE_MAX_YEARLY=price_...

# ============================================
# AI Model APIs
# ============================================
# OpenAI (Sora 2)
OPENAI_API_KEY=sk-...
# Google GenAI (Veo 3.1, Gemini, Imagen thumbnails)
GOOGLE_API_KEY=...
GEMINI_API_KEY=...

# ============================================
# Wan (provider vidéo open source self-hosted — OPTIONNEL)
# Micro-service GPU à héberger (contrat HTTP documenté dans wan_client.py).
# Si WAN_ENDPOINT est absent, le modèle "wan" est simplement désactivé.
# ============================================
# WAN_ENDPOINT=http://your-gpu-box:8000
# WAN_API_KEY=...

# ============================================
# Notifications WhatsApp via passerelle OpenWA (OPTIONNEL)
# https://github.com/rmyndharis/OpenWA — conteneur Docker persistant requis.
# Si une variable manque, les notifications sont simplement désactivées.
# ============================================
# OPENWA_URL=http://your-host:2785
# OPENWA_API_KEY=...
# OPENWA_SESSION_ID=default
# OPENWA_CHAT_ID=33612345678@c.us

# ============================================
# Storage Configuration
# ============================================
# Bucket Supabase Storage pour les vidéos générées
VIDEOS_BUCKET=vykso-videos

# ============================================
# App Configuration
# ============================================
PORT=8080
ENVIRONMENT=production
# Timeout de polling des générations vidéo (secondes)
VIDEO_POLL_TIMEOUT_SECONDS=900
# Concurrence max des générations de segments par job
VIDEO_MAX_CONCURRENT_SHOTS=3
# Jobs actifs simultanés max par utilisateur
MAX_ACTIVE_JOBS_PER_USER=2
# Watchdog : un job pending/generating plus vieux que N minutes est marqué failed + remboursé
JOB_STALE_MINUTES=45
